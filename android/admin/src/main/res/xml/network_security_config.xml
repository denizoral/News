<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except the home-network server the app talks to today.
     Remove the exception once the site has a public HTTPS address. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.33</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
