# All optional. Without them the site still runs on the open sources.
# Copy to .env and fill in what you have.

# X (Twitter). Any one of these turns on the X feed; they're tried in this order.
# Without any of these, X posts come from the free public embed timelines.
# How many accounts to fetch per 2-minute run from the embed timelines.
X_EMBED_PER_RUN=4
# 1. X API v2 bearer token (paid, pay-per-use)
X_BEARER_TOKEN=
# 2. A self-hosted RSSHub with X cookies, e.g. https://rsshub.example.com
RSSHUB_URL=
# 3. Comma-separated Nitter instances, e.g. https://nitter.example.com
NITTER_INSTANCES=

# Reddit blocks many anonymous server IPs. Create a free "script" app at
# https://www.reddit.com/prefs/apps and paste its id and secret here.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Raises GitHub's search rate limit.
GITHUB_TOKEN=

PORT=3000
DATA_DIR=data

# ---- Spider and search ----
# Set to off to run only the aggregator (no crawling).
SPIDER=on
# Parallel page fetches (each site still gets one request at a time).
SPIDER_CONCURRENCY=6
# Minimum gap between requests to the same site, in ms. robots.txt Crawl-delay wins if longer.
SPIDER_HOST_DELAY_MS=2000
# Maximum pages fetched per site per day.
SPIDER_HOST_BUDGET=600
# Disk budget for stored images; the oldest are deleted past this.
MEDIA_MAX_GB=5
# Largest single image to store, in MB.
MEDIA_MAX_IMAGE_MB=2
# Show stored full-text copies of crawled pages ("Stored copy" links).
# Off by default: republishing other sites' articles publicly raises copyright issues.
CACHED_COPIES=off
