{
  "name": "Frontier Wire",
  "short_name": "Frontier Wire",
  "description": "The latest AI news from labs, press, X, Reddit and Hacker News, with live odds and breaking alerts.",
  "start_url": "./#news",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef1f4",
  "theme_color": "#2f54eb",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Breaking", "url": "./#breaking", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Saved", "url": "./#saved", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "On X", "url": "./#x", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
